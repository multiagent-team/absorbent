# Переменные окружения Absorbent. Скопируйте файл и впишите свои ключи:
#
#   cp .env.example .env
#
# Файл `.env` читает `docker compose` (см. `compose.yaml`); при запуске из
# исходников переменные экспортируются в оболочку:
#
#   set -a; . ./.env; set +a

# Ключ DeepSeek API: им подписываются запросы vision-модели и модели синтеза
# конспекта, которые включены по умолчанию в config.yaml.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Ключ Mistral API: нужен только для облачного распознавания речи Voxtral
# (`--stt voxtral-transcribe-2`); локальный Whisper работает без него.
MISTRAL_API_KEY=your-mistral-api-key-here

# Прокси для запросов к API задаются стандартными переменными HTTP_PROXY,
# HTTPS_PROXY и ALL_PROXY; absorbent читает их из окружения сам, включая
# схему socks5://.
